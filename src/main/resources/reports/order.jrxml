<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="order"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

    <!-- Parameters baseados na sua entidade Invoice -->
    <parameter name="companyName" class="java.lang.String"/>
    <parameter name="companyAddress" class="java.lang.String"/>
    <parameter name="warehouseName" class="java.lang.String"/>
    <parameter name="customerName" class="java.lang.String"/>
    <parameter name="deliveryAddress" class="java.lang.String"/>
    <parameter name="customerNuit" class="java.lang.String"/>
    <parameter name="customerContact" class="java.lang.String"/>
    <parameter name="customerEmail" class="java.lang.String"/>
    <parameter name="orderNumber" class="java.lang.String"/>
    <parameter name="orderDate" class="java.util.Date"/>
    <parameter name="paymentMethod" class="java.lang.String"/>
    <parameter name="status" class="java.lang.String"/>
    <parameter name="totalAmount" class="java.math.BigDecimal"/>
    <parameter name="notes" class="java.lang.String"/>
    <parameter name="companyPhone" class="java.lang.String"/>
    <parameter name="companyEmail" class="java.lang.String"/>
    <parameter name="companyNuit" class="java.lang.String"/>

    <!-- Fields para os itens da encomenda -->
    <field name="productName" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="unitPrice" class="java.math.BigDecimal"/>
    <field name="totalPrice" class="java.math.BigDecimal"/>

    <!-- Variáveis para cálculos -->
    <variable name="subtotal" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalPrice}]]></variableExpression>
    </variable>

    <!-- Background com marca d'água -->
    <background>
        <band height="802">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="802"
                              forecolor="#F8F9FA" backcolor="#FFFFFF"/>
            </rectangle>
            <textField>
                <reportElement x="0" y="350" width="555" height="100"
                              forecolor="#E9ECEF" mode="Opaque">
                    <printWhenExpression><![CDATA[$P{status}.equals("PAGO")]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="72" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["PAGO"]]></textFieldExpression>
            </textField>
        </band>
    </background>

    <!-- Title - Cabeçalho principal -->
    <title>
        <band height="120">
            <!-- Header com gradiente -->
            <rectangle radius="5">
                <reportElement x="0" y="0" width="555" height="80"
                              forecolor="#FFFFFF" backcolor="#2C3E50"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>

            <!-- Logo e nome da empresa -->
            <textField>
                <reportElement x="20" y="15" width="300" height="25"
                              forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="20" y="45" width="300" height="15"
                              forecolor="#ECF0F1"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{companyAddress}]]></textFieldExpression>
            </textField>

            <!-- Título Encomenda-->
            <staticText>
                <reportElement x="400" y="20" width="135" height="40"
                              forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="24" isBold="true"/>
                </textElement>
                <text><![CDATA[Encomenda ]]></text>
            </staticText>
        </band>
    </title>

    <!-- Page Header - Informações da encomenda -->
    <pageHeader>
        <band height="150">
            <!-- Informações do cliente -->
            <rectangle radius="5">
                <reportElement x="0" y="0" width="270" height="70"
                              forecolor="#F8F9FA" backcolor="#FFFFFF"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E9ECEF"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="10" y="5" width="100" height="15"
                              forecolor="#2C3E50"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Cliente:]]></text>
            </staticText>
            <textField>
                <reportElement x="10" y="20" width="250" height="15"/>
                <textFieldExpression><![CDATA[$P{customerName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="10" y="35" width="250" height="15"/>
                <textFieldExpression><![CDATA[$P{deliveryAddress}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="10" y="50" width="250" height="15"/>
                <textFieldExpression><![CDATA["NUIT: " + $P{customerNuit}]]></textFieldExpression>
            </textField>

            <!-- Informações da fatura -->
            <rectangle radius="5">
                <reportElement x="285" y="0" width="270" height="70"
                              forecolor="#F8F9FA" backcolor="#FFFFFF"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E9ECEF"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="295" y="5" width="100" height="15"
                              forecolor="#2C3E50"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Informações:]]></text>
            </staticText>

            <staticText>
                <reportElement x="295" y="20" width="80" height="15"/>
                <text><![CDATA[Nº Encomenda:]]></text>
            </staticText>
            <textField>
                <reportElement x="370" y="20" width="175" height="15"/>
                <textFieldExpression><![CDATA[$P{orderNumber}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="295" y="35" width="80" height="15"/>
                <text><![CDATA[Data:]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="370" y="35" width="175" height="15"/>
                <textFieldExpression><![CDATA[$P{orderDate}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="295" y="50" width="80" height="15"/>
                <text><![CDATA[Estado:]]></text>
            </staticText>
            <textField>
                <reportElement x="370" y="50" width="175" height="15"/>
                <textFieldExpression><![CDATA[$P{status}]]></textFieldExpression>
            </textField>

            <!-- Informações de contacto e pagamento -->
            <rectangle radius="5">
                <reportElement x="0" y="80" width="555" height="40"
                              forecolor="#F8F9FA" backcolor="#FFFFFF"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E9ECEF"/>
                </graphicElement>
            </rectangle>

            <textField>
                <reportElement x="10" y="85" width="200" height="15"/>
                <textFieldExpression><![CDATA["Contacto: " + $P{customerContact}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="10" y="100" width="200" height="15"/>
                <textFieldExpression><![CDATA["Email: " + $P{customerEmail}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="300" y="85" width="245" height="15"/>
                <textFieldExpression><![CDATA["Método Pagamento: " + $P{paymentMethod}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="300" y="100" width="245" height="15"/>
                <textFieldExpression><![CDATA["Armazém: " + $P{warehouseName}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- Column Header - Cabeçalho da tabela -->
    <columnHeader>
        <band height="30">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="30"
                              forecolor="#2C3E50" backcolor="#2C3E50"/>
            </rectangle>

            <staticText>
                <reportElement x="0" y="5" width="200" height="20"
                              forecolor="#FFFFFF"/>
                <textElement textAlignment="Left">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[PRODUTO]]></text>
            </staticText>

            <staticText>
                <reportElement x="200" y="5" width="80" height="20"
                              forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[QUANTIDADE]]></text>
            </staticText>

            <staticText>
                <reportElement x="280" y="5" width="100" height="20"
                              forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[PREÇO UNITÁRIO]]></text>
            </staticText>

            <staticText>
                <reportElement x="380" y="5" width="95" height="20"
                              forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[SUBTOTAL]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail - Itens da encomenda -->
    <detail>
        <band height="25">
            <!-- Background alternado para linhas -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="25"
                              mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>

            <!-- Linha separadora -->
            <line>
                <reportElement x="0" y="24" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E9ECEF"/>
                </graphicElement>
            </line>

            <textField>
                <reportElement x="0" y="2" width="200" height="20"/>
                <textFieldExpression><![CDATA[$F{productName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="200" y="2" width="80" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.00 MT">
                <reportElement x="280" y="2" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.00 MT">
                <reportElement x="380" y="2" width="95" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{totalPrice}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Summary - Total e observações -->
    <summary>
        <band height="160">
            <!-- Linha separadora -->
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#2C3E50"/>
                </graphicElement>
            </line>

            <!-- Total -->
            <staticText>
                <reportElement x="380" y="20" width="95" height="20"/>
                <textElement textAlignment="Right">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL:]]></text>
            </staticText>

            <textField pattern="#,##0.00 MT">
                <reportElement x="380" y="40" width="95" height="25"/>
                <textElement textAlignment="Right">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{totalAmount}]]></textFieldExpression>
            </textField>

            <!-- Observações -->
            <rectangle radius="5">
                <reportElement x="0" y="75" width="555" height="50"
                              forecolor="#F8F9FA" backcolor="#FFFFFF"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E9ECEF"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="10" y="80" width="100" height="15"
                              forecolor="#2C3E50"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Observações:]]></text>
            </staticText>

            <textField isStretchWithOverflow="true">
                <reportElement x="10" y="95" width="535" height="25"/>
                <textFieldExpression><![CDATA[$P{notes} != null ? $P{notes} : "Agradecemos a sua preferência!"]]></textFieldExpression>
            </textField>

            <!-- Informações da empresa no rodapé -->
            <textField>
                <reportElement x="0" y="130" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{companyName} + " | " + $P{companyPhone} + " | " + $P{companyEmail}]]></textFieldExpression>
            </textField>

            <!-- Rodapé final -->
            <staticText>
                <reportElement x="0" y="145" width="555" height="10"/>
                <textElement textAlignment="Center">
                    <font size="7" isItalic="true"/>
                </textElement>
                <text><![CDATA[Documento gerado electronicamente - Valor fiscal]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>