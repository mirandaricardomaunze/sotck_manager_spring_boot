<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                            http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="ThermalSaleReport"
        pageWidth="200"
        pageHeight="842"
        columnWidth="180"
        leftMargin="10"
        rightMargin="10"
        topMargin="10"
        bottomMargin="10"
        uuid="87654321-4321-4321-4321-cba987654321">

    <!-- ===================== -->
    <!--        ESTILOS        -->
    <!-- ===================== -->
    <style name="Title" fontName="Arial" fontSize="14" isBold="true"/>
    <style name="Subtitle" fontName="Arial" fontSize="9" isBold="true"/>
    <style name="Text" fontName="Arial" fontSize="8"/>
    <style name="Header" fontName="Arial" fontSize="8" isBold="true"/>
    <style name="Total" fontName="Arial" fontSize="10" isBold="true"/>
    <style name="Footer" fontName="Arial" fontSize="7" isItalic="true"/>

    <!-- ===================== -->
    <!--      PARÂMETROS       -->
    <!-- ===================== -->
    <parameter name="SALE_NUMBER" class="java.lang.Long"/>
    <parameter name="SALE_DATE" class="java.util.Date"/>
    <parameter name="SALE_TIME" class="java.lang.String"/>
    <parameter name="CUSTOMER_NAME" class="java.lang.String"/>
    <parameter name="USER_NAME" class="java.lang.String"/>
    <parameter name="COMPANY_NAME" class="java.lang.String"/>
    <parameter name="COMPANY_ADDRESS" class="java.lang.String"/>
    <parameter name="COMPANY_PHONE" class="java.lang.String"/>
    <parameter name="COMPANY_NUIT" class="java.lang.String"/>
    <parameter name="THANK_YOU_MSG" class="java.lang.String"/>

    <!-- ===================== -->
    <!--        CAMPOS         -->
    <!-- ===================== -->
    <field name="productName" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="unitPrice" class="java.math.BigDecimal"/>
    <field name="subtotal" class="java.math.BigDecimal"/>
    <field name="taxAmount" class="java.math.BigDecimal"/>

    <!-- ===================== -->
    <!--       VARIÁVEIS       -->
    <!-- ===================== -->

    <!-- Subtotal sem IVA -->
    <variable name="SUBTOTAL_SEM_IVA" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
    </variable>

    <!-- Total IVA -->
    <variable name="TOTAL_IVA" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[
            $F{taxAmount} == null ? java.math.BigDecimal.ZERO : $F{taxAmount}
        ]]></variableExpression>
    </variable>

    <!-- Total Geral com IVA -->
    <variable name="TOTAL_GERAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[
            $F{subtotal}.add(
                $F{taxAmount} == null ? java.math.BigDecimal.ZERO : $F{taxAmount}
            )
        ]]></variableExpression>
    </variable>

    <!-- ===================== -->
    <!--         TÍTULO        -->
    <!-- ===================== -->
    <title>
        <band height="140">

            <textField>
                <reportElement x="0" y="0" width="180" height="15" style="Title"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="16" width="180" height="10" style="Text"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{COMPANY_ADDRESS}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="27" width="180" height="10" style="Text"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[
                    "Tel: " + $P{COMPANY_PHONE} + " | NUIT: " + $P{COMPANY_NUIT}
                ]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="40" width="180" height="1"/>
            </line>

            <textField>
                <reportElement x="0" y="45" width="180" height="12" style="Subtitle"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["VENDA Nº " + $P{SALE_NUMBER}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="58" width="180" height="10" style="Text"/>
                <textFieldExpression><![CDATA["Cliente: " + $P{CUSTOMER_NAME}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="69" width="180" height="10" style="Text"/>
                <textFieldExpression><![CDATA[
                    "Data: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{SALE_DATE})
                    + " " + $P{SALE_TIME}
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="80" width="180" height="10" style="Text"/>
                <textFieldExpression><![CDATA["Operador: " + $P{USER_NAME}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="95" width="180" height="1"/>
            </line>

        </band>
    </title>

    <!-- ===================== -->
    <!--   CABEÇALHO PRODUTOS  -->
    <!-- ===================== -->
    <columnHeader>
        <band height="15">
            <staticText>
                <reportElement x="0" y="0" width="90" height="15" style="Header"/>
                <text><![CDATA[Produto]]></text>
            </staticText>
            <staticText>
                <reportElement x="90" y="0" width="25" height="15" style="Header"/>
                <text><![CDATA[Qtd]]></text>
            </staticText>
            <staticText>
                <reportElement x="115" y="0" width="30" height="15" style="Header"/>
                <text><![CDATA[Preço]]></text>
            </staticText>
            <staticText>
                <reportElement x="145" y="0" width="35" height="15" style="Header"/>
                <text><![CDATA[Total]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ===================== -->
    <!--        DETALHE        -->
    <!-- ===================== -->
    <detail>
        <band height="15">

            <textField>
                <reportElement x="0" y="0" width="90" height="15" style="Text"/>
                <textFieldExpression><![CDATA[$F{productName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="90" y="0" width="25" height="15" style="Text"/>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="115" y="0" width="30" height="15" style="Text"/>
                <textFieldExpression><![CDATA[
                    "MT " + new java.text.DecimalFormat("###,##0.00").format($F{unitPrice})
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="145" y="0" width="35" height="15" style="Text"/>
                <textFieldExpression><![CDATA[
                    "MT " + new java.text.DecimalFormat("###,##0.00").format(
                        $F{subtotal}.add(
                            $F{taxAmount} == null ? java.math.BigDecimal.ZERO : $F{taxAmount}
                        )
                    )
                ]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ===================== -->
    <!--         RESUMO        -->
    <!-- ===================== -->
    <summary>
        <band height="80">

            <line>
                <reportElement x="0" y="0" width="180" height="1"/>
            </line>

            <!-- Subtotal -->
            <textField>
                <reportElement x="0" y="5" width="110" height="10" style="Text"/>
                <textFieldExpression><![CDATA["Subtotal"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="110" y="5" width="70" height="10" style="Text"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[
                    "MT " + new java.text.DecimalFormat("###,##0.00").format($V{SUBTOTAL_SEM_IVA})
                ]]></textFieldExpression>
            </textField>

            <!-- IVA -->
            <textField>
                <reportElement x="0" y="20" width="110" height="10" style="Text"/>
                <textFieldExpression><![CDATA["IVA"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="110" y="20" width="70" height="10" style="Text"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[
                    "MT " + new java.text.DecimalFormat("###,##0.00").format($V{TOTAL_IVA})
                ]]></textFieldExpression>
            </textField>

            <!-- Total Geral -->
            <textField>
                <reportElement x="0" y="35" width="110" height="15" style="Total"/>
                <textFieldExpression><![CDATA["TOTAL A PAGAR"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="110" y="35" width="70" height="15" style="Total"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[
                    "MT " + new java.text.DecimalFormat("###,##0.00").format($V{TOTAL_GERAL})
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="55" width="180" height="10" style="Footer"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{THANK_YOU_MSG}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="65" width="180" height="10" style="Footer"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Processado pelo sistema Mirasoft"]]></textFieldExpression>
            </textField>

        </band>
    </summary>

</jasperReport>
